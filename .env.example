# Industrial Safety Intelligence Platform - Environment Configuration

# Backend Configuration
PROJECT_NAME="Industrial Safety Event Intelligence Platform"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# Database URL
# Default SQLite:
DATABASE_URL="sqlite:///./industrial_safety.db"
# PostgreSQL production example:
# DATABASE_URL="postgresql://safety_admin:secure_password@localhost:5432/industrial_safety"

# Deterministic Generator Defaults
DEFAULT_SEED=20261022
DEFAULT_STARTER_EVENTS=2500
DEFAULT_FULL_EVENTS=50000

# CORS Allowed Origins (comma separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
